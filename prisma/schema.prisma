generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShopStatus {
  ACTIVE
  UNINSTALLED
  SUSPENDED
}

enum KnowledgeSourceType {
  SHOPIFY_CATALOG
  STORE_POLICIES
  FAQ
  GUIDE
  DOCUMENT
  MANUAL
}

enum KnowledgeStatus {
  ACTIVE
  INACTIVE
  PROCESSING
  ERROR
  ARCHIVED
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  EXPIRED
}

enum ConversationChannel {
  STOREFRONT_WIDGET
  ADMIN_PREVIEW
  AGENT_EXTERNAL
}

enum JourneyStage {
  DISCOVER
  COMPARE
  CONFIRM
  CART
  CHECKOUT
  COMPLETED
  ABANDONED
  EXPIRED
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

model Shop {
  id               String     @id @default(cuid())
  shopDomain       String     @unique
  shopifyShopId    String?    @unique
  storefrontOrigin String?
  status           ShopStatus @default(ACTIVE)
  installedAt      DateTime   @default(now())
  uninstalledAt    DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  merchantConfig      MerchantConfig?
  knowledgeSources    KnowledgeSource[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  conversations       Conversation[]
  messages            Message[]
  commerceSessions    CommerceSession[]
  commerceEvents      CommerceEvent[]
  customerTokens      CustomerToken[]
  oauthStates         OAuthState[]
  customerAccountUrls CustomerAccountUrls[]
  webhookReceipts     WebhookReceipt[]

  @@index([status])
}

model MerchantConfig {
  id                  String   @id @default(cuid())
  shopId              String   @unique
  assistantName       String
  personality         String   @db.Text
  brandVoice          String   @db.Text
  welcomeMessage      String   @db.Text
  quickPrompts        Json
  commerceRules       Json
  recommendationRules Json
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  id           String              @id @default(cuid())
  shopId       String
  type         KnowledgeSourceType
  name         String
  status       KnowledgeStatus     @default(ACTIVE)
  sourceUrl    String?
  externalId   String?
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@unique([shopId, type, externalId])
  @@index([shopId, status])
}

model KnowledgeDocument {
  id          String          @id @default(cuid())
  shopId      String
  sourceId    String
  title       String
  content     String          @db.Text
  status      KnowledgeStatus @default(ACTIVE)
  version     Int             @default(1)
  checksum    String
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  shop   Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  source KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@unique([shopId, sourceId, checksum])
  @@index([shopId, status])
  @@index([sourceId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  shopId     String
  documentId String
  position   Int
  content    String   @db.Text
  tokenCount Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@index([shopId, documentId])
}

model Conversation {
  id         String              @id
  shopId     String
  customerId String?
  visitorId  String?
  status     ConversationStatus  @default(ACTIVE)
  channel    ConversationChannel @default(STOREFRONT_WIDGET)
  startedAt  DateTime            @default(now())
  endedAt    DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages            Message[]
  commerceSession     CommerceSession?
  commerceEvents      CommerceEvent[]
  customerTokens      CustomerToken[]
  oauthStates         OAuthState[]
  customerAccountUrls CustomerAccountUrls?

  @@index([shopId, status, updatedAt])
  @@index([shopId, visitorId])
}

model Message {
  id                String   @id @default(cuid())
  shopId            String
  conversationId    String
  role              String
  content           String   @db.Text
  structuredContent Json?
  toolCalls         Json?
  toolResults       Json?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  latencyMs         Int?
  createdAt         DateTime @default(now())

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([shopId, conversationId, createdAt])
}

model CommerceSession {
  id                  String       @id @default(cuid())
  shopId              String
  conversationId      String       @unique
  visitorId           String?
  customerId          String?
  journeyStage        JourneyStage @default(DISCOVER)
  structuredIntent    Json?
  constraints         Json
  recommendedProducts Json
  comparedProducts    Json
  selectedProductId   String?
  selectedVariantId   String?
  quantity            Int          @default(1)
  cartId              String?
  checkoutUrl         String?
  buyerContext        Json
  pendingMessages     Json
  version             Int          @default(1)
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events       CommerceEvent[]

  @@index([shopId, journeyStage, updatedAt])
  @@index([shopId, expiresAt])
  @@index([shopId, cartId])
}

model CommerceEvent {
  id                String   @id @default(cuid())
  shopId            String
  conversationId    String?
  commerceSessionId String?
  eventType         String
  payload           Json
  requestId         String
  occurredAt        DateTime @default(now())

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation    Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  commerceSession CommerceSession? @relation(fields: [commerceSessionId], references: [id], onDelete: SetNull)

  @@index([shopId, eventType, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([commerceSessionId, occurredAt])
}

model CustomerToken {
  id                    String   @id @default(cuid())
  shopId                String
  conversationId        String?
  customerReference     String
  encryptedAccessToken  String   @db.Text
  encryptedRefreshToken String?  @db.Text
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([shopId, customerReference])
  @@index([shopId, conversationId])
  @@index([shopId, expiresAt])
}

model OAuthState {
  id                    String    @id @default(cuid())
  stateHash             String    @unique
  shopId                String
  conversationId        String?
  encryptedCodeVerifier String?   @db.Text
  redirectUri           String?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([shopId, expiresAt])
  @@index([conversationId])
}

model CustomerAccountUrls {
  id               String   @id @default(cuid())
  shopId           String
  conversationId   String   @unique
  mcpApiUrl        String?
  authorizationUrl String?
  tokenUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model WebhookReceipt {
  id          String   @id @default(cuid())
  webhookId   String   @unique
  shopId      String?
  shopDomain  String
  topic       String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopDomain, topic, processedAt])
  @@index([shopId])
}
