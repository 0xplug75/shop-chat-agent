# Application
NODE_ENV=
# Required on deployed services: development, preview, or production.
APP_ENV=
# Platform-provided runtime hint; do not override on Railway unless required.
RAILWAY_ENVIRONMENT_NAME=
APP_URL=
PORT=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=
SHOP_CUSTOM_DOMAIN=

# PostgreSQL / Supabase
# Use the pooler URL at runtime and the direct database URL for migrations.
DATABASE_URL=
DIRECT_URL=
# Isolated disposable database used only by PostgreSQL integration tests.
TEST_DATABASE_URL=

# LLM
AI_PROVIDER=
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=1
LLM_FALLBACK_PROVIDERS=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=
# Optional accounting rates in USD per million tokens. Leave blank when unknown.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
KIMI_INPUT_COST_PER_MILLION_USD=
KIMI_OUTPUT_COST_PER_MILLION_USD=
# Retained compatibility adapter; leave unset for the current OpenAI/Kimi release.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Legacy Moonshot key alias; prefer KIMI_API_KEY.
MOONSHOT_API_KEY=

# Customer Accounts OAuth
REDIRECT_URL=
OAUTH_STATE_TTL_SECONDS=

# Encryption
TOKEN_ENCRYPTION_KEY=

# Public widget security
WIDGET_SIGNING_SECRET=
WIDGET_TOKEN_TTL_SECONDS=
WIDGET_ALLOWED_ORIGINS=
WIDGET_RATE_LIMIT_PER_MINUTE=
WIDGET_NETWORK_RATE_LIMIT_PER_MINUTE=
WIDGET_SHOP_RATE_LIMIT_PER_MINUTE=
WIDGET_BOOTSTRAP_RATE_LIMIT_PER_MINUTE=

# Commerce
COMMERCE_SESSION_TTL_SECONDS=
# Local protocol integration only. `fixture_non_live` is rejected in production.
SAGE_INTEGRATION_MODE=
UCP_AGENT_PROFILE_URL=
UCP_ACCESS_TOKEN=
# Comma-separated exact hostnames for external UCP businesses in stable environments.
UCP_ALLOWED_BUSINESS_HOSTS=
UCP_CHECKOUT_ENABLED=false

# Logging
LOG_LEVEL=

# Legacy compatibility during API-key migration; prefer ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
