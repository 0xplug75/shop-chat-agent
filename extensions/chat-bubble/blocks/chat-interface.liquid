{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div
  class="shop-ai-chat-container shop-ai-layout-{{ block.settings.widget_layout }} shop-ai-position-{{ block.settings.widget_position }}"
  data-shop-ai-layout="{{ block.settings.widget_layout }}"
  data-shop-ai-position="{{ block.settings.widget_position }}"
  style="
    --shop-ai-primary: {{ block.settings.chat_bubble_color }};
    --shop-ai-background: {{ block.settings.widget_background_color }};
    --shop-ai-text: {{ block.settings.widget_text_color }};
  "
>
  <div class="shop-ai-chat-bubble">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </div>

  <div class="shop-ai-choice-panel" aria-hidden="true">
    <div class="shop-ai-choice-header">
      <span class="shop-ai-choice-kicker">Shopping assistant</span>
      <button class="shop-ai-choice-close" aria-label="Close">✕</button>
    </div>
    <h2>How do you want to shop?</h2>
    <p>Browse the store yourself, or describe what you need and let the agent pull matching products into the chat.</p>
    <div class="shop-ai-choice-actions">
      <button class="shop-ai-start-chat" type="button">{{ block.settings.primary_cta_label }}</button>
      <button class="shop-ai-continue-browsing" type="button">Continue browsing</button>
    </div>
  </div>

  <div class="shop-ai-chat-window">
    <div class="shop-ai-chat-header">
      <div>
        <span class="shop-ai-chat-eyebrow">Chat mode</span>
        <strong>{{ 'chat.title' | t }}</strong>
      </div>
      <button class="shop-ai-chat-close">✕</button>
    </div>

    <div class="shop-ai-chat-messages">
      <!-- Messages will be added here by JavaScript -->
    </div>

    <div class="shop-ai-suggestions" aria-label="Suggested shopping prompts">
      <button type="button" data-shop-ai-prompt="I need help finding the right product for me. Ask me what matters and recommend the best options.">Find the right product</button>
      <button type="button" data-shop-ai-prompt="Compare the best products for my needs and explain which one I should choose.">Compare options</button>
      <button type="button" data-shop-ai-prompt="Show me products that are available now and help me add the best one to cart.">Ready to buy</button>
    </div>

    <div class="shop-ai-chat-input">
      <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
      <button class="shop-ai-chat-send">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: {{ block.settings.welcome_message | json }},
    backendUrl: {{ block.settings.backend_url | json }},
    widget: {
      layout: {{ block.settings.widget_layout | json }},
      position: {{ block.settings.widget_position | json }},
      primaryCtaLabel: {{ block.settings.primary_cta_label | json }},
      colors: {
        primary: {{ block.settings.chat_bubble_color | json }},
        background: {{ block.settings.widget_background_color | json }},
        text: {{ block.settings.widget_text_color | json }}
      },
      behavior: {
        openOnLoad: {{ block.settings.open_on_load | json }},
        showQuickActions: {{ block.settings.show_quick_actions | json }},
        entryBehavior: {{ block.settings.entry_behavior | json }}
      }
    }
  };
  window.shopId = {{ shop.id }};
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Widget experience"
    },
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Accent color",
      "default": "#5046e4"
    },
    {
      "type": "color",
      "id": "widget_background_color",
      "label": "Widget background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "widget_text_color",
      "label": "Widget text",
      "default": "#111827"
    },
    {
      "type": "select",
      "id": "widget_layout",
      "label": "Widget type",
      "options": [
        {
          "value": "bubble",
          "label": "Bubble"
        },
        {
          "value": "side-panel",
          "label": "Side panel"
        },
        {
          "value": "inline",
          "label": "Inline section"
        },
        {
          "value": "fullscreen",
          "label": "Fullscreen chat"
        }
      ],
      "default": "bubble"
    },
    {
      "type": "select",
      "id": "widget_position",
      "label": "Position",
      "options": [
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "top-left",
          "label": "Top left"
        }
      ],
      "default": "bottom-right"
    },
    {
      "type": "select",
      "id": "entry_behavior",
      "label": "Entry behavior",
      "info": "Auto uses the best default for each widget type. Choice opens the shopping choice card first. Direct opens chat immediately.",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "choice",
          "label": "Show choice card"
        },
        {
          "value": "direct",
          "label": "Open chat directly"
        }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "Tell me what you are shopping for. I will search the catalog, compare the best matches, and help you add the right product to cart."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Shop with chat"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "open_on_load",
      "label": "Open automatically",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_actions",
      "label": "Show quick actions",
      "default": true
    },
    {
      "type": "header",
      "content": "Assistant"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "Assistant mode",
      "options": [
        {
          "value": "standardAssistant",
          "label": "Standard Assistant"
        },
        {
          "value": "agenticBuyingAssistant",
          "label": "Agentic Buying Assistant"
        },
        {
          "value": "enthusiasticAssistant",
          "label": "Enthusiastic Assistant"
        }
      ],
      "default": "agenticBuyingAssistant"
    },
    {
      "type": "header",
      "content": "Development"
    },
    {
      "type": "text",
      "id": "backend_url",
      "label": "Backend URL",
      "info": "Use the Shopify app dev tunnel URL, or an app proxy path such as /apps/intentcart. Keep / to use the storefront origin.",
      "default": "/"
    }
  ]
}
{% endschema %}
