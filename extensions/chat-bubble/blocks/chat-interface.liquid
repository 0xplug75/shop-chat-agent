{{ 'chat.css' | asset_url | stylesheet_tag }}

<div
  class="
    shop-ai-chat-container
    shop-ai-layout-{{ block.settings.widget_layout }}
    shop-ai-position-{{ block.settings.widget_position }}
    shop-ai-launcher-{{ block.settings.launcher_style }}
  "
  data-shop-ai-layout="{{ block.settings.widget_layout }}"
  data-shop-ai-position="{{ block.settings.widget_position }}"
  style="
    --shop-ai-primary: {{ block.settings.chat_bubble_color }};
    --shop-ai-background: {{ block.settings.widget_background_color }};
    --shop-ai-text: {{ block.settings.widget_text_color }};
    --shop-ai-radius: {{ block.settings.corner_radius }}px;
  "
>
  <button
    class="shop-ai-chat-bubble"
    type="button"
    aria-label="{{ block.settings.launcher_label | escape }}"
    aria-expanded="false"
    aria-controls="shop-ai-chat-window"
  >
    <span class="shop-ai-launcher-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        <path d="M8 9h8M8 13h5"/>
      </svg>
    </span>
    <span class="shop-ai-launcher-text">{{ block.settings.launcher_label }}</span>
  </button>

  <section
    class="shop-ai-choice-panel"
    aria-hidden="true"
    aria-labelledby="shop-ai-choice-title"
  >
    <div class="shop-ai-surface-header">
      <div class="shop-ai-identity">
        <span class="shop-ai-avatar" aria-hidden="true">S</span>
        <div>
          <strong data-shop-ai-assistant-name>{{ 'chat.title' | t }}</strong>
          <small>{{ 'chat.subtitle' | t }}</small>
        </div>
      </div>
      <button class="shop-ai-choice-close shop-ai-icon-button" type="button" aria-label="{{ 'chat.closeButton' | t }}">
        &times;
      </button>
    </div>

    <div class="shop-ai-choice-content">
      <span class="shop-ai-choice-kicker">{{ 'chat.choiceKicker' | t }}</span>
      <h2 id="shop-ai-choice-title">{{ 'chat.choiceTitle' | t }}</h2>
      <p>{{ block.settings.welcome_message }}</p>

      <div class="shop-ai-choice-actions">
        <button class="shop-ai-start-chat" type="button">
          {{ block.settings.primary_cta_label }}
        </button>
        <button class="shop-ai-continue-browsing" type="button">
          {{ 'chat.continueBrowsing' | t }}
        </button>
      </div>
    </div>

    <p class="shop-ai-trust-note">{{ 'chat.shopifyTrust' | t }}</p>
  </section>

  <section
    id="shop-ai-chat-window"
    class="shop-ai-chat-window"
    aria-hidden="true"
    aria-labelledby="shop-ai-chat-title"
  >
    <div class="shop-ai-chat-header">
      <div class="shop-ai-identity">
        <span class="shop-ai-avatar" aria-hidden="true">S</span>
        <div>
          <strong id="shop-ai-chat-title" data-shop-ai-assistant-name>{{ 'chat.title' | t }}</strong>
          <small>{{ 'chat.subtitle' | t }}</small>
        </div>
      </div>
      <button class="shop-ai-chat-close shop-ai-icon-button" type="button" aria-label="{{ 'chat.closeButton' | t }}">
        &times;
      </button>
    </div>

    <div class="shop-ai-chat-messages" aria-live="polite"></div>

    <div class="shop-ai-suggestions" aria-label="{{ 'chat.suggestionsLabel' | t }}">
      <button type="button" data-shop-ai-prompt="I need help finding the right product for me. Ask me what matters and recommend the best options.">
        {{ 'chat.quickFind' | t }}
      </button>
      <button type="button" data-shop-ai-prompt="Compare the best products for my needs and explain which one I should choose.">
        {{ 'chat.quickCompare' | t }}
      </button>
      <button type="button" data-shop-ai-prompt="Show me products that are available now and help me add the best one to cart.">
        {{ 'chat.quickBuy' | t }}
      </button>
    </div>

    <div class="shop-ai-composer">
      <div class="shop-ai-chat-input">
        <input
          type="text"
          aria-label="{{ 'chat.inputLabel' | t }}"
          placeholder="{{ 'chat.inputPlaceholder' | t }}"
          autocomplete="off"
        >
        <button class="shop-ai-chat-send" type="button" aria-label="{{ 'chat.sendButton' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12 14-7-4 14-3-6-7-1Z"/>
          </svg>
        </button>
      </div>
      <small>{{ 'chat.composerTrust' | t }}</small>
    </div>
  </section>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: "agenticBuyingAssistant",
    welcomeMessage: {{ block.settings.welcome_message | json }},
    backendUrl: {{ block.settings.backend_url | json }},
    widget: {
      layout: {{ block.settings.widget_layout | json }},
      position: {{ block.settings.widget_position | json }},
      primaryCtaLabel: {{ block.settings.primary_cta_label | json }},
      launcherLabel: {{ block.settings.launcher_label | json }},
      launcherStyle: {{ block.settings.launcher_style | json }},
      cornerRadius: {{ block.settings.corner_radius | json }},
      colors: {
        primary: {{ block.settings.chat_bubble_color | json }},
        background: {{ block.settings.widget_background_color | json }},
        text: {{ block.settings.widget_text_color | json }}
      },
      behavior: {
        openOnLoad: {{ block.settings.open_on_load | json }},
        showQuickActions: {{ block.settings.show_quick_actions | json }},
        entryBehavior: {{ block.settings.entry_behavior | json }}
      }
    }
  };
</script>

{% schema %}
{
  "name": "IntentCart Assistant",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Widget"
    },
    {
      "type": "select",
      "id": "widget_layout",
      "label": "Widget type",
      "options": [
        {
          "value": "bubble",
          "label": "Compact button"
        },
        {
          "value": "side-panel",
          "label": "Floating assistant"
        },
        {
          "value": "inline",
          "label": "Inline shopping block"
        },
        {
          "value": "fullscreen",
          "label": "Full-screen shopping"
        }
      ],
      "default": "bubble"
    },
    {
      "type": "select",
      "id": "widget_position",
      "label": "Position",
      "options": [
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "top-left",
          "label": "Top left"
        }
      ],
      "default": "bottom-right"
    },
    {
      "type": "select",
      "id": "launcher_style",
      "label": "Launcher style",
      "options": [
        {
          "value": "label",
          "label": "Icon and text"
        },
        {
          "value": "icon",
          "label": "Icon only"
        }
      ],
      "default": "label"
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Launcher label",
      "default": "Ask Sage"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Accent",
      "default": "#5046e4"
    },
    {
      "type": "color",
      "id": "widget_background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "widget_text_color",
      "label": "Text",
      "default": "#111827"
    },
    {
      "type": "header",
      "content": "Welcome"
    },
    {
      "type": "textarea",
      "id": "welcome_message",
      "label": "Welcome message",
      "default": "Tell me what you are looking for and I will help you choose."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button",
      "default": "Shop with Sage"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "select",
      "id": "entry_behavior",
      "label": "When shoppers open it",
      "info": "Auto uses the recommended behavior for each widget type.",
      "options": [
        {
          "value": "auto",
          "label": "Recommended"
        },
        {
          "value": "choice",
          "label": "Show introduction first"
        },
        {
          "value": "direct",
          "label": "Open chat directly"
        }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "show_quick_actions",
      "label": "Show suggested questions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_on_load",
      "label": "Open automatically",
      "default": false
    },
    {
      "type": "header",
      "content": "Development"
    },
    {
      "type": "text",
      "id": "backend_url",
      "label": "Backend URL",
      "info": "Use the current Shopify CLI tunnel during local development. Leave / for a same-origin app proxy.",
      "default": "/"
    }
  ]
}
{% endschema %}
