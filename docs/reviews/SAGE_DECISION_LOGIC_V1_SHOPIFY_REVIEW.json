      "revalidation": "stateRevision, cartVersion, variant, quantity, price and stock immediately before mutation",
      "execution": "durable journal then provider with one propagated idempotency key",
      "result": "authoritative success, failed_before_mutation or outcome_unknown"
    },
    {
      "action": "request_checkout_handoff",
      "permission": "checkout capability and merchant policy",
      "confirmation": "required for checkout create or update; policy-defined for safe existing handoff",
      "revalidation": "cartVersion, lines, availability and safe continuation URL",
      "execution": "journal if side-effecting",
      "result": "authoritative checkout handoff, never purchase completion"
    },
    {
      "action": "complete_checkout",
      "permission": "out of V1 by default",
      "confirmation": "separate strong confirmation if ever enabled",
      "revalidation": "dedicated checkout and payment state",
      "execution": "denied by the V1 handoff",
      "result": "denied or dedicated authoritative result"
    }
