{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magpie-lab:decision-experience-input:1.0",
  "title": "DecisionExperienceInput v1",
  "description": "Framework-agnostic Magpie decision projection. Runtime validation enforces payload coherence and rejects score fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "decisionId",
    "stateRevision",
    "decisionType",
    "messageIntent",
    "systemConfidence",
    "shopperConfidence",
    "allowedNextActions",
    "disclosures"
  ],
  "properties": {
    "kind": { "const": "DecisionExperienceInput" },
    "version": { "const": "1.0" },
    "decisionId": { "$ref": "#/$defs/opaqueRef" },
    "stateRevision": { "type": "integer", "minimum": 0 },
    "decisionType": {
      "enum": ["clarification", "recommendation", "comparison", "explanation", "abstention", "escalation", "commerce_handoff"]
    },
    "messageIntent": { "$ref": "#/$defs/code" },
    "question": { "$ref": "clarification-question.schema.json" },
    "recommendations": { "$ref": "#/$defs/recommendationPlan" },
    "comparison": { "$ref": "#/$defs/comparisonPlan" },
    "explanation": { "$ref": "#/$defs/explanationPlan" },
    "systemConfidence": { "$ref": "#/$defs/systemConfidence" },
    "shopperConfidence": { "$ref": "#/$defs/shopperConfidence" },
    "allowedNextActions": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/allowedAction" }
    },
    "disclosures": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "$defs": {
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_./-]{0,127}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "stringList": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "scalarValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 500 },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "maxLength": 500 },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      ]
    },
    "refList": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueRef" }
    },
    "systemConfidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "intentSufficiency", "constraintCoverage", "evidenceCoverage", "rankingStability", "sourceFreshness", "calibrated", "warnings"],
      "properties": {
        "band": { "enum": ["INSUFFICIENT", "CONDITIONAL", "STRONG"] },
        "intentSufficiency": { "enum": ["insufficient", "partial", "usable"] },
        "constraintCoverage": { "enum": ["unknown", "partial", "complete"] },
        "evidenceCoverage": { "enum": ["missing", "partial", "sufficient"] },
        "rankingStability": { "enum": ["unstable", "conditional", "stable"] },
        "sourceFreshness": { "enum": ["unknown", "stale", "acceptable"] },
        "calibrated": { "const": false },
        "warnings": { "$ref": "#/$defs/stringList" }
      }
    },
    "shopperConfidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "evidence", "inferredFromBehaviorOnly", "nextSupport"],
      "properties": {
        "band": { "enum": ["UNKNOWN", "LOW", "ADEQUATE"] },
        "evidence": { "enum": ["explicit_confusion", "explicit_understanding", "explicit_choice", "comparison_request", "none"] },
        "inferredFromBehaviorOnly": { "const": false },
        "nextSupport": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["EXPLAIN", "COMPARE", "SHOW_EVIDENCE", "NONE"] }
        }
      }
    },
    "allowedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "actionType"],
      "properties": {
        "actionId": { "$ref": "#/$defs/opaqueRef" },
        "actionType": {
          "enum": ["submit_intent", "compare_products", "select_product", "ask_about_product", "select_option", "set_candidate_quantity", "request_cart_add", "request_checkout_handoff"]
        },
        "targetRef": { "$ref": "#/$defs/opaqueRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actionType": {
                "enum": ["select_product", "ask_about_product", "request_cart_add", "request_checkout_handoff"]
              }
            }
          },
          "then": { "required": ["targetRef"] }
        }
      ]
    },
    "recommendationProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productRef", "needMatched", "confirmedCriteriaUsed", "whyCodes", "tradeoffs", "limits", "evidenceRefs", "provenanceRefs", "allowedNextActions"],
      "properties": {
        "productRef": { "$ref": "#/$defs/opaqueRef" },
        "needMatched": { "$ref": "#/$defs/stringList" },
        "confirmedCriteriaUsed": { "$ref": "#/$defs/refList" },
        "whyCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/code" }
        },
        "tradeoffs": { "$ref": "#/$defs/stringList" },
        "limits": { "$ref": "#/$defs/stringList" },
        "evidenceRefs": {
          "allOf": [{ "$ref": "#/$defs/refList" }, { "minItems": 1 }]
        },
        "provenanceRefs": {
          "allOf": [{ "$ref": "#/$defs/refList" }, { "minItems": 1 }]
        },
        "allowedNextActions": { "$ref": "#/$defs/refList" }
      }
    },
    "recommendationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "stateRevision", "products", "selectionRationale", "omittedCandidateReasons"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/opaqueRef" },
        "stateRevision": { "type": "integer", "minimum": 0 },
        "products": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/recommendationProduct" }
        },
        "selectionRationale": {
          "allOf": [{ "$ref": "#/$defs/stringList" }, { "minItems": 1 }]
        },
        "omittedCandidateReasons": { "$ref": "#/$defs/stringList" }
      }
    },
    "comparisonValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productRef", "status"],
      "properties": {
        "productRef": { "$ref": "#/$defs/opaqueRef" },
        "status": { "enum": ["known", "missing", "unknown", "not_applicable"] },
        "value": { "$ref": "#/$defs/scalarValue" },
        "evidenceRef": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "comparisonPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateRevision", "productRefs", "axes", "bestFor", "decisiveTradeoff", "allowedNextActions"],
      "properties": {
        "stateRevision": { "type": "integer", "minimum": 0 },
        "productRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueRef" }
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimensionId", "values"],
            "properties": {
              "dimensionId": { "$ref": "#/$defs/code" },
              "values": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/comparisonValue" }
              }
            }
          }
        },
        "bestFor": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["productRef", "condition"],
            "properties": {
              "productRef": { "$ref": "#/$defs/opaqueRef" },
              "condition": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "decisiveTradeoff": { "type": "string", "minLength": 1, "maxLength": 500 },
        "allowedNextActions": { "$ref": "#/$defs/refList" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimType", "subjectRef", "value", "observationRefs", "evidenceRefs", "provenanceRefs"],
      "properties": {
        "claimType": { "enum": ["need_match", "constraint_match", "tradeoff", "limit", "missing_information"] },
        "subjectRef": { "$ref": "#/$defs/opaqueRef" },
        "value": { "$ref": "#/$defs/scalarValue" },
        "observationRefs": { "$ref": "#/$defs/refList" },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "provenanceRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "explanationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageIntent", "claims", "confirmedCriteriaUsed", "forbiddenClaims", "toneConstraints"],
      "properties": {
        "messageIntent": { "enum": ["recommendation", "comparison", "discouragement", "abstention", "clarification"] },
        "claims": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/claim" }
        },
        "confirmedCriteriaUsed": { "$ref": "#/$defs/refList" },
        "forbiddenClaims": { "$ref": "#/$defs/stringList" },
        "toneConstraints": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
